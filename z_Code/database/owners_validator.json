{
  "$and": [
    {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "owner_id",
          "person_id",
          "document_key",
          "identity_document",
          "activity",
          "active",
          "documentation_up_to_date",
          "needs_renewal",
          "reference_dates"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "string"
          },
          "owner_id": {
            "bsonType": "string",
            "pattern": "^O[0-9a-f]{24}$"
          },
          "person_id": {
            "bsonType": "string",
            "pattern": "^P[0-9a-f]{24}$"
          },
          "document_key": {
            "bsonType": "string"
          },
          "identity_document": {
            "bsonType": "object",
            "required": [
              "issuing_country",
              "type",
              "number",
              "nationality",
              "expires_on",
              "is_synthetic"
            ],
            "additionalProperties": false,
            "properties": {
              "issuing_country": {
                "enum": [
                  "PT",
                  "GB"
                ]
              },
              "type": {
                "enum": [
                  "CC",
                  "PASSPORT"
                ]
              },
              "number": {
                "bsonType": "string"
              },
              "nationality": {
                "enum": [
                  "Portuguese",
                  "British"
                ]
              },
              "expires_on": {
                "bsonType": "date"
              },
              "is_synthetic": {
                "enum": [
                  true
                ]
              }
            }
          },
          "activity": {
            "bsonType": "object",
            "required": [
              "accommodation_count",
              "recent_review_count",
              "latest_publication_date",
              "period_start",
              "assessment_date"
            ],
            "additionalProperties": false,
            "properties": {
              "accommodation_count": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1
              },
              "recent_review_count": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0
              },
              "latest_publication_date": {
                "bsonType": [
                  "date",
                  "null"
                ]
              },
              "period_start": {
                "bsonType": "date"
              },
              "assessment_date": {
                "bsonType": "date"
              }
            }
          },
          "active": {
            "bsonType": "bool"
          },
          "documentation_up_to_date": {
            "bsonType": "bool"
          },
          "needs_renewal": {
            "bsonType": "bool"
          },
          "reference_dates": {
            "bsonType": "object",
            "required": [
              "activity_as_of",
              "status_as_of"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_as_of": {
                "bsonType": "date"
              },
              "status_as_of": {
                "bsonType": "date"
              }
            }
          }
        }
      }
    },
    {
      "$expr": {
        "$and": [
          {
            "$eq": [
              "$_id",
              "$owner_id"
            ]
          },
          {
            "$eq": [
              "$owner_id",
              {
                "$concat": [
                  "O",
                  {
                    "$substrCP": [
                      {
                        "$convert": {
                          "input": "$person_id",
                          "to": "string",
                          "onError": "",
                          "onNull": ""
                        }
                      },
                      1,
                      24
                    ]
                  }
                ]
              }
            ]
          },
          {
            "$eq": [
              "$document_key",
              {
                "$concat": [
                  {
                    "$convert": {
                      "input": "$identity_document.issuing_country",
                      "to": "string",
                      "onError": "",
                      "onNull": ""
                    }
                  },
                  ":",
                  {
                    "$convert": {
                      "input": "$identity_document.type",
                      "to": "string",
                      "onError": "",
                      "onNull": ""
                    }
                  },
                  ":",
                  {
                    "$convert": {
                      "input": "$identity_document.number",
                      "to": "string",
                      "onError": "",
                      "onNull": ""
                    }
                  }
                ]
              }
            ]
          },
          {
            "$or": [
              {
                "$and": [
                  {
                    "$eq": [
                      "$identity_document.issuing_country",
                      "PT"
                    ]
                  },
                  {
                    "$eq": [
                      "$identity_document.type",
                      "CC"
                    ]
                  },
                  {
                    "$eq": [
                      "$identity_document.nationality",
                      "Portuguese"
                    ]
                  },
                  {
                    "$cond": [
                      {
                        "$regexMatch": {
                          "input": {
                            "$convert": {
                              "input": "$identity_document.number",
                              "to": "string",
                              "onError": "",
                              "onNull": ""
                            }
                          },
                          "regex": "^[0-9]{9}[A-Z0-9]{2}[0-9]$"
                        }
                      },
                      {
                        "$eq": [
                          {
                            "$mod": [
                              {
                                "$sum": {
                                  "$map": {
                                    "input": {
                                      "$range": [
                                        0,
                                        12
                                      ]
                                    },
                                    "as": "i",
                                    "in": {
                                      "$let": {
                                        "vars": {
                                          "v": {
                                            "$multiply": [
                                              {
                                                "$indexOfCP": [
                                                  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
                                                  {
                                                    "$substrCP": [
                                                      {
                                                        "$convert": {
                                                          "input": "$identity_document.number",
                                                          "to": "string",
                                                          "onError": "",
                                                          "onNull": ""
                                                        }
                                                      },
                                                      "$$i",
                                                      1
                                                    ]
                                                  }
                                                ]
                                              },
                                              {
                                                "$cond": [
                                                  {
                                                    "$eq": [
                                                      {
                                                        "$mod": [
                                                          "$$i",
                                                          2
                                                        ]
                                                      },
                                                      0
                                                    ]
                                                  },
                                                  2,
                                                  1
                                                ]
                                              }
                                            ]
                                          }
                                        },
                                        "in": {
                                          "$cond": [
                                            {
                                              "$and": [
                                                {
                                                  "$eq": [
                                                    {
                                                      "$mod": [
                                                        "$$i",
                                                        2
                                                      ]
                                                    },
                                                    0
                                                  ]
                                                },
                                                {
                                                  "$gte": [
                                                    "$$v",
                                                    10
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "$subtract": [
                                                "$$v",
                                                9
                                              ]
                                            },
                                            "$$v"
                                          ]
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              10
                            ]
                          },
                          0
                        ]
                      },
                      false
                    ]
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$eq": [
                      "$identity_document.issuing_country",
                      "GB"
                    ]
                  },
                  {
                    "$eq": [
                      "$identity_document.type",
                      "PASSPORT"
                    ]
                  },
                  {
                    "$eq": [
                      "$identity_document.nationality",
                      "British"
                    ]
                  },
                  {
                    "$regexMatch": {
                      "input": {
                        "$convert": {
                          "input": "$identity_document.number",
                          "to": "string",
                          "onError": "",
                          "onNull": ""
                        }
                      },
                      "regex": "^[0-9]{9}$"
                    }
                  }
                ]
              }
            ]
          },
          {
            "$eq": [
              "$active",
              {
                "$gt": [
                  "$activity.recent_review_count",
                  0
                ]
              }
            ]
          },
          {
            "$eq": [
              "$documentation_up_to_date",
              {
                "$gte": [
                  "$identity_document.expires_on",
                  "$reference_dates.status_as_of"
                ]
              }
            ]
          },
          {
            "$eq": [
              "$needs_renewal",
              {
                "$not": [
                  {
                    "$gte": [
                      "$identity_document.expires_on",
                      "$reference_dates.status_as_of"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "$eq": [
              "$reference_dates.activity_as_of",
              "$activity.assessment_date"
            ]
          },
          {
            "$lte": [
              "$activity.period_start",
              "$activity.assessment_date"
            ]
          },
          {
            "$or": [
              {
                "$eq": [
                  "$activity.latest_publication_date",
                  null
                ]
              },
              {
                "$lte": [
                  "$activity.latest_publication_date",
                  "$activity.assessment_date"
                ]
              }
            ]
          },
          {
            "$eq": [
              "$active",
              {
                "$and": [
                  {
                    "$ne": [
                      "$activity.latest_publication_date",
                      null
                    ]
                  },
                  {
                    "$gte": [
                      "$activity.latest_publication_date",
                      "$activity.period_start"
                    ]
                  },
                  {
                    "$lte": [
                      "$activity.latest_publication_date",
                      "$activity.assessment_date"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "$gte": [
              "$identity_document.expires_on",
              {
                "$dateFromString": {
                  "dateString": "1900-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$lt": [
              "$identity_document.expires_on",
              {
                "$dateFromString": {
                  "dateString": "2200-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$gte": [
              "$reference_dates.status_as_of",
              {
                "$dateFromString": {
                  "dateString": "1900-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$lt": [
              "$reference_dates.status_as_of",
              {
                "$dateFromString": {
                  "dateString": "2200-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$gte": [
              "$activity.period_start",
              {
                "$dateFromString": {
                  "dateString": "1900-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$lt": [
              "$activity.period_start",
              {
                "$dateFromString": {
                  "dateString": "2200-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$gte": [
              "$activity.assessment_date",
              {
                "$dateFromString": {
                  "dateString": "1900-01-01T00:00:00Z"
                }
              }
            ]
          },
          {
            "$lt": [
              "$activity.assessment_date",
              {
                "$dateFromString": {
                  "dateString": "2200-01-01T00:00:00Z"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
