{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1",
    "analysis": {
      "analyzer": {
        "review_text": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "review_id": {
        "type": "keyword"
      },
      "person_id": {
        "type": "keyword"
      },
      "listing_id": {
        "type": "keyword"
      },
      "date": {
        "type": "date",
        "format": "strict_date"
      },
      "comments": {
        "type": "text",
        "analyzer": "review_text"
      },
      "review_score": {
        "type": "float"
      },
      "embedding_status": {
        "type": "keyword"
      },
      "embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw"
        }
      },
      "observed_at": {
        "type": "date",
        "format": "strict_date_time_no_millis"
      },
      "quality_flags": {
        "type": "keyword"
      },
      "observations": {
        "type": "object",
        "enabled": false
      },
      "resolution": {
        "type": "object",
        "enabled": false
      }
    }
  }
}
